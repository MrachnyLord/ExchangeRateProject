@page
@model ExchangeRateProject.Pages.ConverterModel
@{
    ViewData["Title"] = "Конвертер валют";
}

<h1 class="mb-2">Конвертер валют</h1>
<p class="text-muted mb-4">
    Конвертація за офіційним курсом НБУ або за курсами Монобанку та ПриватБанку.
</p>

@if (!string.IsNullOrEmpty(Model.ViewModel.ErrorMessage))
{
    <div class="alert alert-warning">@Model.ViewModel.ErrorMessage</div>
}

<div class="row">
    <div class="col-lg-6">
        <form method="post" class="card shadow-sm">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="Amount">Сума</label>
                    <input type="number" step="0.01" min="0.01" class="form-control" id="Amount"
                           name="Amount" value="@Model.ViewModel.Amount" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" for="FromCurrency">З валюти</label>
                    <select class="form-select" id="FromCurrency" name="FromCurrency">
                        @foreach (var currency in Model.ViewModel.AvailableCurrencies)
                        {
                            <option value="@currency" selected="@(Model.ViewModel.FromCurrency == currency)">@currency</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="ToCurrency">У валюту</label>
                    <select class="form-select" id="ToCurrency" name="ToCurrency">
                        @foreach (var currency in Model.ViewModel.AvailableCurrencies)
                        {
                            <option value="@currency" selected="@(Model.ViewModel.ToCurrency == currency)">@currency</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="RateSource">Банк</label>
                    <select class="form-select" id="RateSource" name="RateSource">
                        @foreach (var bank in ConverterPageViewModel.AvailableBanks)
                        {
                            <option value="@bank.Value" selected="@(Model.ViewModel.RateSource == bank.Value)">@bank.Label</option>
                        }
                    </select>
                </div>
                <button type="submit" class="btn btn-primary w-100">Конвертувати</button>
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        @if (Model.ViewModel.Result.HasValue)
        {
            <div class="card border-success h-100">
                <div class="card-header bg-success text-white">Результат</div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <p class="display-6 mb-0 text-center">
                        <strong>@Model.ViewModel.Amount.ToString("N2") @Model.ViewModel.FromCurrency</strong>
                        <br />
                        <span class="text-muted">=</span>
                        <br />
                        <strong class="text-success">@Model.ViewModel.Result.Value.ToString("N4") @Model.ViewModel.ToCurrency</strong>
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="card bg-light h-100">
                <div class="card-body text-muted d-flex align-items-center justify-content-center">
                    Введіть суму і натисніть «Конвертувати»
                </div>
            </div>
        }
    </div>
</div>

<p class="text-muted small mt-4">
    Для банків: купівля — коли ви продаєте валюту банку, продаж — коли купуєте валюту в банку.
</p>